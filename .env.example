# Environment variables for this Django backend.
# Local development: the app works WITHOUT these (sensible local defaults are used).
# Render: set these in the Render dashboard (Environment tab).
# Do NOT commit the real .env file.

# Django security key.
# Local dev fallback value is used if unset.
# Generate a strong one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "True" for local development, "False" on Render (production).
# Named DJANGO_DEBUG (not DEBUG) to avoid clashing with unrelated env vars.
DJANGO_DEBUG=True

# Comma-separated allowed hosts, e.g.:
#   myapp.onrender.com,localhost
# Leave empty for local development.
ALLOWED_HOSTS=

# Render only: PostgreSQL connection string provided by Render
# (e.g. postgres://user:password@host:5432/dbname). Local dev keeps SQLite.
DATABASE_URL=

# Note: backend/.env currently also holds VITE_API_URL, which is used by the
# frontend (NOT by Django). The frontend reads it at build time.